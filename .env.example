APP_URL=http://localhost:8080 # Expected origin of the support form, without a trailing slash.
HOST=127.0.0.1 # Listen locally until a reverse proxy is configured.
PORT=8080 # HTTP port used by the Java server.
DB_URL=jdbc:h2:file:./.data/support # Embedded database containing requests and receipt states.
DB_PASSWORD= # Optional local H2 password; keep the database directory private.
ADMIN_PASSWORD= # Choose at least 16 random characters to protect the request list.
APP_ENV=development # Use production on a deployed instance; disables preview-only mail.
MAIL_MODE=sandbox # sandbox captures receipts; production sends them; log saves local previews.
MAIL_FROM=sender@example.com # Receipt sender; production requires your verified sending domain.
MAILTRAP_SANDBOX_USER= # SMTP username from the support-testing inbox.
MAILTRAP_SANDBOX_PASSWORD= # That inbox's SMTP password, not your account login password.
MAILTRAP_PRODUCTION_TOKEN= # Transactional sending token, only read in production mail mode.
PREVIEW_DIR=.data/mail-preview # Private folder for development .eml files.
